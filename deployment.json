{
  "schemaVersion": 1,
  "project": "consilith",
  "platform": {
    "image": "consilith-platform:local",
    "build": {
      "packages": [
        "packages/contracts",
        "packages/plugin-runtime",
        "apps/room",
        "apps/referee"
      ],
      "requirements": [
        "consilith-room",
        "consilith-referee"
      ]
    }
  },
  "plugins": [
    {
      "id": "starter",
      "image": "consilith-agentic-starter:local",
      "entryPoint": "consilith_agentic_starter:extension",
      "build": {
        "packages": [
          "packages/contracts",
          "packages/plugin-runtime",
          "examples/agentic-plugin-template"
        ],
        "requirements": [
          "consilith-plugin-runtime",
          "consilith-agentic-starter"
        ]
      },
      "mcpServices": [
        "solver-starter"
      ]
    }
  ],
  "mcpServices": [
    {
      "id": "solver-starter",
      "image": "consilith-agentic-starter-mcp:local",
      "url": "http://solver-starter:8080/mcp",
      "command": [
        "python",
        "/app/container.py",
        "solver"
      ],
      "environment": {
        "CONSILITH_SOLVER_MODULE": "consilith_agentic_starter.server",
        "CONSILITH_MCP_ALLOWED_HOSTS": "[\"solver-starter:8080\", \"localhost:*\", \"127.0.0.1:*\"]"
      },
      "build": {
        "packages": [
          "packages/contracts",
          "examples/agentic-plugin-template"
        ],
        "requirements": [
          "consilith-agentic-starter"
        ]
      }
    }
  ]
}

        },
        "shannon": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShannonEnvironment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ionic_radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,

        },
        "reduced_formula": {
          "title": "Reduced Formula",
          "type": "string"
        },
        "n_sites": {
          "title": "N Sites",
          "type": "integer"
        },
        "density": {
          "description": "g/cm^3",
          "title": "Density",
          "type": "number"
        },

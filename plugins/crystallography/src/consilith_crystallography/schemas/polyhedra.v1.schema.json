          "title": "Ionic Radius"
        },
        "ionic_radius_cn": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Coordination number the ionic radius is tabulated for",
          "title": "Ionic Radius Cn"
        },
        "type_ids": {
          "items": {
            "type": "string"
          },
          "title": "Type Ids",
          "type": "array"
        }
      },
      "required": [
        "site_label",
        "element",
        "wyckoff",
        "site_symmetry",
        "multiplicity_in_cell",
        "representative_frac",
        "oxidation_state",
        "coordination_number",
        "ligand_formula",
        "shape",
        "forms_polyhedron",
        "reason",
        "symmetry_consistent",
        "type_ids"
      ],
      "title": "SiteEnvironmentRecord",
      "type": "object"
    },
    "Source": {
      "properties": {
        "kind": {
          "enum": [
            "materials_project",
            "optimade",
            "example",
            "cif"
          ],
